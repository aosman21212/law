<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Law Management privilege (groups category) -->
        <record id="privilege_law" model="res.groups.privilege">
            <field name="name">إدارة المكتب القانوني</field>
            <field name="sequence">56</field>
        </record>

        <record id="group_law_user" model="res.groups">
            <field name="name">موظف</field>
            <field name="privilege_id" ref="privilege_law"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_law_manager" model="res.groups">
            <field name="name">مدير</field>
            <field name="privilege_id" ref="privilege_law"/>
            <field name="implied_ids" eval="[(4, ref('group_law_user'))]"/>
        </record>

        <record id="group_law_admin" model="res.groups">
            <field name="name">مدير عام</field>
            <field name="privilege_id" ref="privilege_law"/>
            <field name="implied_ids" eval="[(4, ref('group_law_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
